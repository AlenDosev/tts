  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/image": "^2.1.0",
    "@nuxt/scripts": "^1.3.9",
    "@nuxtjs/i18n": "^10.6.0",
    "@pinia/nuxt": "^1.0.2",
    "@types/ramda": "^0.32.0",
    "@unhead/vue": "^3.4.1",
    "nuxt": "^4.5.2",
    "ramda": "^0.32.0",
    "swiper": "^14.2.0"
  },
  "devDependencies": {
    "eslint": "^10.11.0",
    "pinia": "^4.0.3",
    "prettier": "^3.9.9",
    "sass": "^1.105.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.11"
  },
  "allowScripts": {
    "esbuild": false,
    "sharp": false,
    "unrs-resolver": false,
    "@parcel/watcher": false,
